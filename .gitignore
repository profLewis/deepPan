# =========================================================================
# Regenerable intermediates — build from data/Tenor Pan only.obj via
# `./build_from_scratch.sh`. None of these belong in git.
# =========================================================================

# Notepads + grooves + mounts: regenerated by generate_*.py + solidify_grooves.py
data/notepads/*.obj
data/notepads/*.stl
data/notepads/*.png
data/notepads/cap.*
data/notepads/.DS_Store
data/notepads/solid/
data/grooves/*.obj
data/grooves/*.stl
data/mounts/*.obj
data/mounts/*.stl
data/mounts/solid/

# Body / assembly intermediates: regenerated by generate_pan_holes.py,
# extend_pan_holes.py, thicken_blender.py, combine_pan_assembly.py,
# remesh_assembly.py
data/quarters/*.obj
data/quarters/*.stl

# Bowl-derived per-piece outputs from older workflows
data/pan*.obj
data/pan*.stl
data/pan_body*.npz
data/pan_surface_up*.obj
data/pan_surface_up*.stl
data/pan_shell*.obj
data/pan_body*.html
data/pantry*.obj
data/pantry*.stl
data/drum_rim.obj
data/drum_rim.stl
data/blended.blend*
data/manual.stl
data/*.png

# Source bowl (large, downloaded/checked out separately)
data/Tenor Pan only.obj

# Final outputs: only the build script writes here. Keep the directory but
# ignore generated STL/OBJ binaries so we don't commit gigabytes.
# The MANIFEST.sha256 and Bambu .3mf build plates ARE committed so end users
# can verify regeneration and print without rebuilding from scratch.
pipeline_output/*.obj
pipeline_output/*.stl
!pipeline_output/MANIFEST.sha256
!pipeline_output/3mf/

# Python / system noise
__pycache__/
*.py[cod]
.DS_Store
.claude/
*.pyc
